# Copier en .env (ignoré par git) : cp .env.example .env
# 🔒 Clé du proxy LiteLLM (générer : openssl rand -hex 32)
LITELLM_MASTER_KEY=
# 🔒 Bearer exigé par l'API Vector Stores (générer : openssl rand -hex 32)
VECTOR_API_KEY=
# 🔒 Base DÉDIÉE (pas celle du RAG de prod) : Neon « litellm_vectors », connexion DIRECTE (sans -pooler)
#    ou Postgres local : postgresql://portfolio:portfolio@host.docker.internal:5432/litellm_vectors
VECTOR_DATABASE_URL=
# Modèle d'embedding (nom dans litellm-config.yaml) et sa dimension
EMBEDDING_MODEL=all-minilm
EMBEDDING_DIMENSIONS=384
