generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model content_entries {
  id                String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug              String              @unique
  raw_markdown      String
  publish_date      DateTime?           @db.Date
  section_id        String              @db.Uuid
  created_at        DateTime            @default(dbgenerated("timezone('utc'::text, now())")) @db.Timestamptz(6)
  content_hash      String?             @default(dbgenerated("content_sha256(raw_markdown)"))
  content_sections  content_sections    @relation(fields: [section_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  content_tags      content_tags[]
  vector_embeddings vector_embeddings[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model content_sections {
  id              String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title           String
  category        String            @unique
  description     String?
  created_at      DateTime          @default(dbgenerated("timezone('utc'::text, now())")) @db.Timestamptz(6)
  content_entries content_entries[]
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model content_tags {
  content_entry_id String          @db.Uuid
  tag_id           String          @db.Uuid
  content_entries  content_entries @relation(fields: [content_entry_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  tags             tags            @relation(fields: [tag_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([content_entry_id, tag_id])
  @@index([tag_id])
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model tags {
  id           String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name         String         @unique
  color_code   String?
  content_tags content_tags[]
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model vector_embeddings {
  id               String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  text_chunk       String
  embedding_vector Unsupported("vector")
  content_entry_id String                @db.Uuid
  created_at       DateTime              @default(dbgenerated("timezone('utc'::text, now())")) @db.Timestamptz(6)
  metadata         Json                  @default("{}")
  embedding_model  String                @default("Xenova/all-MiniLM-L6-v2")
  chunk_index      Int?
  content_entries  content_entries       @relation(fields: [content_entry_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([content_entry_id])
  @@index([embedding_vector], map: "vector_embeddings_embedding_hnsw_idx")
  @@index([metadata(ops: JsonbPathOps)], type: Gin)
}

model schema_migrations {
  version    String   @id
  applied_at DateTime @default(now()) @db.Timestamptz(6)
}
